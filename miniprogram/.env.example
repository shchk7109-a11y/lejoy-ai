# 构建通道：develop | trial | release
TARO_APP_RELEASE_CHANNEL=develop

# 三种通道分别使用的 REST 服务地址。
TARO_APP_API_BASE_URL_DEVELOP=http://127.0.0.1:3000
TARO_APP_API_BASE_URL_TRIAL=https://api.example.com
TARO_APP_API_BASE_URL_RELEASE=https://api.example.com

# 可选的一次性覆盖值；通常不要设置，避免把体验版误连到本地地址。
#TARO_APP_API_BASE_URL=
