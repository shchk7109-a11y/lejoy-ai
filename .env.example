# ============================================================
# 乐享AI 环境配置示例（P0 境内模型链路升级版）
# 复制为 .env 并填入实际值
# ============================================================

# ─── 基础 ───────────────────────────────────────────────────
NODE_ENV=production
DATABASE_URL=mysql://lejoy_user:密码@rm-xxx.mysql.rds.aliyuncs.com:3306/lejoy_ai
JWT_SECRET=请生成一个随机长字符串

# ─── 微信小程序 M1 ─────────────────────────────────────────
# 两者同时留空时启用 mock 登录；任意 wx.login code 均登录为本地测试用户
WECHAT_MINI_APPID=
WECHAT_MINI_SECRET=
# off（默认，本地直接放行）| wechat（调用微信文本/媒体内容安全接口）
CONTENT_SECURITY=off

# ─── 境内模型平台（生产主链路）──────────────────────────────
# 月之暗面 Kimi（文本生成 + 视觉理解）https://platform.kimi.com
MOONSHOT_API_KEY=sk-xxx
# 日常任务模型（k2.6 支持视觉，性价比好）；重任务用 MOONSHOT_MODEL_HEAVY
MOONSHOT_MODEL=kimi-k2.6
MOONSHOT_MODEL_HEAVY=kimi-k3

# 火山引擎方舟 即梦 Seedream（修图/生图）https://console.volcengine.com/ark
ARK_API_KEY=xxx
# ⚠️ 部署前在方舟控制台"模型广场"核实当前模型ID的确切版本号
ARK_IMAGE_MODEL=doubao-seedream-4-0-250828
# AIGC 内容标识合规：保持 true（图片自动加水印）
ARK_IMAGE_WATERMARK=true

# 阿里云 DashScope（TTS语音合成 + ASR语音识别）https://bailian.console.aliyun.com
DASHSCOPE_API_KEY=sk-xxx
DASHSCOPE_TTS_MODEL=qwen3-tts-flash
DASHSCOPE_ASR_MODEL=qwen3-asr-flash

# ─── 能力级供应商切换（默认 auto：有密钥即用境内新链路）────
# 可选值：text: kimi|minimax|gemini  image: volc|minimax|gemini
#        tts: ali|minimax|gemini    asr: ali|forge
# 效果对比时可临时切回旧链路，例如 AI_IMAGE_PROVIDER=gemini
AI_TEXT_PROVIDER=auto
AI_IMAGE_PROVIDER=auto
AI_TTS_PROVIDER=auto
AI_ASR_PROVIDER=auto

# ─── 文件存储：阿里云 OSS（S3兼容模式）────────────────────
# 配置后替代 Manus 内置存储；桶建议开公开读并配 CDN/自定义域名
S3_ENDPOINT=https://oss-cn-shanghai.aliyuncs.com
S3_REGION=cn-shanghai
S3_BUCKET=lejoy-ai
S3_ACCESS_KEY_ID=LTAIxxx
S3_SECRET_ACCESS_KEY=xxx
# 公开访问域名（强烈建议配置，否则生成签名URL、7天过期）
S3_PUBLIC_BASE_URL=https://lejoy-ai.oss-cn-shanghai.aliyuncs.com

# ─── 遗留链路（可选，仅做效果对比/降级备用）────────────────
# 谷高API中转 Gemini —— 不要用于收费小程序生产环境
#GEMINI_BASE_URL=https://api.gdoubolai.com/v1
#GEMINI_TEXT_API_KEY=
#GEMINI_IMAGE_API_KEY=
#GEMINI_TTS_API_KEY=
# MiniMax（备用文本/TTS/图片）
#MINIMAX_API_KEY=

# ─── Manus 平台遗留（独立部署时留空即可；登录改造在 P1 完成）─
#OAUTH_SERVER_URL=
#VITE_APP_ID=
#BUILT_IN_FORGE_API_URL=
#BUILT_IN_FORGE_API_KEY=
